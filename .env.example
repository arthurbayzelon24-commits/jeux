# Copiez ce fichier en .env puis renseignez les valeurs. Ne commitez jamais .env.

# --- Hébergement sur votre serveur (docker-compose.yml) ----------------------
# Adresse publique du site. Laissée vide, deploy/install.sh utilise <ip>.sslip.io.
DOMAIN=

# --- Serveur ---------------------------------------------------------------
PORT=3000
# 127.0.0.1 = accessible uniquement depuis cette machine. 0.0.0.0 pour l'exposer.
HOST=127.0.0.1
# Dossier des créations (JSON + fichiers). Relatif à la racine du projet.
SOLVEX_DATA_DIR=data

# --- Accès (recommandé dès que le serveur est exposé) ----------------------
# Code demandé à l'ouverture du studio. Vide = pas de protection (usage local).
SOLVEX_ACCESS_CODE=
# Secret de signature des sessions. Sans lui, les sessions expirent à chaque redémarrage.
# Générez-en un : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SOLVEX_SESSION_SECRET=
# true si le site est servi en HTTPS (cookie Secure).
SOLVEX_SECURE_COOKIES=false
# true derrière un reverse proxy de confiance (lit X-Forwarded-For pour la limitation de débit).
SOLVEX_TRUST_PROXY=false

# --- Limites ---------------------------------------------------------------
SOLVEX_MAX_UPLOAD_MB=20
SOLVEX_UPLOAD_TTL_MIN=60
SOLVEX_RATE_GENERATE_PER_MIN=6
SOLVEX_RATE_UPLOAD_PER_MIN=30
SOLVEX_RATE_ENHANCE_PER_MIN=20
SOLVEX_MAX_CONCURRENT_JOBS=3
SOLVEX_IMAGE_TIMEOUT_S=300
SOLVEX_VIDEO_TIMEOUT_S=900
SOLVEX_VIDEO_POLL_S=10

# --- Images : OpenAI (API Images) ------------------------------------------
OPENAI_API_KEY=
# gpt-image-2 par défaut. gpt-image-1 est arrêté par OpenAI le 23/10/2026 ;
# gpt-image-1-mini et gpt-image-1.5 le 01/12/2026.
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_BASE_URL=https://api.openai.com/v1
# Facultatif : modèle de langage utilisé par « Améliorer le prompt » (Chat Completions).
# Laissé vide, l'amélioration se fait localement par règles, et l'interface l'indique.
OPENAI_TEXT_MODEL=
# Facultatif : transcription automatique des sous-titres (/audio/transcriptions).
# Avec un modèle Whisper, les sous-titres sont minutés ; sinon le texte arrive en un seul bloc.
OPENAI_TRANSCRIBE_MODEL=

# --- Vidéo : Google Veo (API Gemini) ---------------------------------------
GEMINI_API_KEY=
GEMINI_VIDEO_MODEL=veo-3.1-generate-preview
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- Images gratuites : Pollinations (sans clé) -----------------------------
# Service tiers gratuit, activé par défaut : la description de l'image est envoyée
# à Pollinations (le serveur SOLVEX télécharge le résultat). Accès anonyme limité.
# Mettez false pour le désactiver (par exemple si vous ne voulez utiliser qu'OpenAI).
POLLINATIONS_ENABLED=true
POLLINATIONS_BASE_URL=https://image.pollinations.ai
# Facultatif : modèle Pollinations à demander (laissé vide = modèle par défaut du service).
POLLINATIONS_MODEL=

# --- Assistant conversationnel SOLVEX AI -------------------------------------
# SOLVEX AI n'est pas un modèle entraîné par SOLVEX : c'est un modèle de langage
# existant, appelé par le serveur (jamais par le navigateur), auquel SOLVEX donne
# des outils (générer, retoucher, chercher une musique, proposer des modifications).
# Détails : docs/ARCHITECTURE-IA.md. Évaluation : npm run eval:assistant
#
# Choix du « cerveau » :
#   openai            → API OpenAI, avec OPENAI_API_KEY ci-dessus
#   openai-compatible → tout serveur au format Chat Completions (Ollama, vLLM,
#                       LM Studio…), par exemple un modèle ouvert sur votre machine
AI_PROVIDER=openai
# Nom exact du modèle. Avec openai : un modèle de discussion de votre compte qui
# accepte les outils (function calling) ; aucune valeur par défaut n'est devinée.
# Laissé vide avec openai : OPENAI_CHAT_MODEL, puis OPENAI_TEXT_MODEL.
AI_MODEL=
# Seulement pour openai-compatible : adresse de l'API, ex. Ollama http://127.0.0.1:11434/v1
AI_BASE_URL=
# Seulement pour openai-compatible, si votre serveur exige une clé.
AI_API_KEY=
# Nombre maximal d'allers-retours outil ↔ modèle par message (garde-fou de coût).
AI_MAX_TOOL_ROUNDS=5
# Durée maximale d'une réponse, en secondes.
AI_TIMEOUT_S=120
# Ancien nom, toujours accepté : modèle OpenAI de l'assistant.
OPENAI_CHAT_MODEL=
SOLVEX_RATE_CHAT_PER_MIN=20

# --- Bibliothèques audio en ligne (facultatif, clés gratuites) --------------
# Musiques sous licences Creative Commons : créez une application sur https://devportal.jamendo.com
JAMENDO_CLIENT_ID=
# Bruitages et ambiances : demandez une clé sur https://freesound.org/apiv2/apply
FREESOUND_API_KEY=
