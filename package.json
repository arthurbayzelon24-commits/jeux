{
  "name": "solvex-ai",
  "version": "2.0.0",
  "description": "SOLVEX AI — studio de création d'images et de vidéos par intelligence artificielle.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "prestart": "node scripts/build.js",
    "start": "node server/index.js",
    "dev": "node scripts/build.js && node --watch server/index.js",
    "test": "node --test \"tests/*.test.js\"",
    "check": "node scripts/check.js",
    "build": "node scripts/check.js && node scripts/build.js",
    "build:static": "node scripts/build.js && node scripts/build-static.js"
  }
}
